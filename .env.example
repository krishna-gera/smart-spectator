# Smart Spectator Desktop Hub Environment Configuration Example
SMART_SPECTATOR_ENV=development
HUB_HOST=0.0.0.0
HUB_PORT=8000
STREAM_PORT=8554
HUB_HMAC_SECRET=smart-spectator-local-secret-key-change-in-prod
LOG_LEVEL=INFO
DATABASE_PATH=smart_spectator.db
RECORDINGS_DIR=recordings
SNAPSHOTS_DIR=snapshots
BACKUP_DIR=backups
LOGS_DIR=logs
PAIRING_PIN_TTL_SECONDS=300
AUTH_TOKEN_TTL_DAYS=30
MAX_PIN_ATTEMPTS=5
PIN_LOCKOUT_SECONDS=60
DEV_MODE=true
EVENT_MIN_CONFIDENCE=0.70
EVENT_CONFIRM_THRESHOLD=0.80
EVENT_CONSECUTIVE=2
EVENT_COOLDOWN_SECONDS=15
RECORDING_MAX_STORAGE_GB=10.0
RECORDING_RETENTION_DAYS=14
MIN_FREE_DISK_MB=500.0
VERIFY_MODEL_CHECKSUMS=true
SMART_SPECTATOR_DEMO_MODE=false
