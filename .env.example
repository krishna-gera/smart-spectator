# ============================================================
# SMART SPECTATOR — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.
# ============================================================

# --- Application ---
APP_ENV=development
APP_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# --- Database (PostgreSQL / Supabase) ---
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/smart_spectator
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Supabase (optional — if using Supabase hosted) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# --- JWT (if self-hosting auth) ---
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Object Storage ---
STORAGE_PROVIDER=supabase
STORAGE_BUCKET=smart-spectator-frames
STORAGE_PUBLIC_URL=https://your-project.supabase.co/storage/v1
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# --- AI / Vision ---
# Provider: yolo | florence | qwen | ollama | mock
VISION_PROVIDER=yolo
# For Ollama VLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VLM_MODEL=llava:7b
# For YOLO
YOLO_MODEL_SIZE=yolov8n   # nano = fastest, also: yolov8s, yolov8m, yolov8l
YOLO_MODEL_PATH=
# Inference device: auto | cpu | cuda | mps
DEVICE=auto
# Edge vs server inference
USE_EDGE_DETECTION=true
# Analysis configuration
ANALYSIS_INTERVAL_SECONDS=2
CONFIDENCE_THRESHOLD=0.75
TEMPORAL_CONFIRMATION_FRAMES=3
FRAME_DIFF_THRESHOLD=0.05

# --- Push Notifications ---
# FCM (Android)
FCM_SERVER_KEY=
FCM_PROJECT_ID=
# APNs (iOS)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY_PATH=

# --- Email Notifications ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@smart-spectator.app

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60
FRAME_UPLOAD_RATE_LIMIT_PER_MINUTE=120

# --- Frame Retention ---
# none | short | standard | full
DEFAULT_FRAME_RETENTION=standard
FRAME_SHORT_RETENTION_HOURS=24
FRAME_STANDARD_RETENTION_DAYS=7

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Feature Flags ---
DEMO_MODE=false
PRIVACY_MODE_DEFAULT=false
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_EMAIL_NOTIFICATIONS=false
